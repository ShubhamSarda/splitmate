{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '\"[\" + (now | strftime(\"%Y-%m-%d %H:%M:%S\")) + \"] \" + .tool_input.command' >> /Users/shubhamsarda/Desktop/splitmate/.claude/bash-history.log"
          }
        ]
      }
    ]
  }
}
